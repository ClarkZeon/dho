{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api?__p=/api" },
    { "source": "/api/(.*)", "destination": "/api?__p=/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
