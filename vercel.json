{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "server/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api?__p=/api" },
    { "source": "/api/(.*)", "destination": "/api?__p=/api/$1" },
    {
      "source": "/((?!api/|robots\\.txt|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
